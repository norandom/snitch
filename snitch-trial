#!/bin/sh
# snitch-trial (root): `snitch default deny` is a trial that goes back to allow by itself
# unless confirmed with `snitch default deny --keep`. It must survive a reboot (a lockout
# usually ends with one), so the deadline is a file, not a timer in memory:
#   /var/lib/snitch-trial/deadline   epoch seconds; removed by --keep and by the revert
#   snitch-trial          (timer, every 30 s) revert once the deadline has passed
#   snitch-trial boot     (before littlesnitch.service) an open trial at boot: revert right away
set -u
f=/var/lib/snitch-trial/deadline
conf=/var/lib/littlesnitch/override/config/main.toml
[ -f "$f" ] || exit 0
if [ "${1:-}" = boot ] || [ "$(date +%s)" -ge "$(cat "$f" 2>/dev/null || echo 0)" ]; then
  [ -f "$conf" ] && sed -i 's/^deny_by_default = true/deny_by_default = false/' "$conf"
  rm -f "$f"
  systemctl try-restart littlesnitch.service   # at boot it isn't running yet: starts with allow
  echo "deny-by-default trial ended (${1:-deadline}): Little Snitch is back on allow by default"
fi
