def dev_rules():
    """Two rules per program: started in the session (primary = the session, via = the program; never
    a session-wide rule, that would open the hosts to everything) and running on its own."""
    out = []
    for tool, paths, hosts, *launchers in DEV_TOOLS:
        launchers = launchers[0] if launchers else [SESSION]
        for p in paths:
            remote = ({"type": "localNet"} if hosts == "localnet" else {"type": "any"} if hosts == "any"
                      else {"type": "ipAddresses", "value": hosts[3:]} if hosts.startswith("ip:")
                      else {"type": "domains", "value": hosts})
            where = p.replace(H, "~")
            for launcher in launchers:
                place = "in the session" if launcher == SESSION else f"started by {Path(launcher).name}"
                out.append(rule("allow", launcher, p, remote, note=f"snitch dev: {tool}, {where}, {place}"))
            if SESSION in launchers:
                out.append(rule("allow", p, None, remote, note=f"snitch dev: {tool}, {where}, on its own"))
    return out


def norm(r, key):
    """A rule field as the daemon stores it ("Any" port -> "0-65535")."""
    v = r.get(key)
    return "0-65535" if key == "port" and v in ("Any", None) else v


def baseline(dev=False):
    want = BASELINE + (dev_rules() if dev else [])
    same = ("primaryExecutable", "viaExecutable", "remotePattern", "port", "protocol", "direction", "action")
    have = {r.get("notes"): r for r in asyncio.run(daemon_rules())[0]}
    missing = [r for r in want if r["notes"] not in have]
    changed = [{**r, "id": have[r["notes"]]["id"], "creationDate": have[r["notes"]]["creationDate"]}
               for r in want if r["notes"] in have and any(norm(r, k) != norm(have[r["notes"]], k) for k in same)]
    if missing or changed: asyncio.run(daemon_rules(missing, changed))
    stored = {r.get("notes"): r for r in asyncio.run(daemon_rules())[0]}  # read back: the daemon batches its replies
    for r in want:
        state = ("MISSING  " if r["notes"] not in stored else "added    " if r["notes"] not in have
                 else "updated  " if any(r["notes"] == c["notes"] for c in changed) else "present  ")
        if any(norm(r, k) != norm(stored.get(r["notes"], {}), k) for k in same): state = "MISSING  "
        print(state + r["notes"])
    if any(norm(r, k) != norm(stored.get(r["notes"], {}), k) for r in want for k in same):
        sys.exit("some rules were not stored as wanted")


def deny_by_default():
    try: return tomllib.loads((LS_OVERRIDE if LS_OVERRIDE.exists() else LS_CONF).read_text()).get("deny_by_default", False)
    except (OSError, tomllib.TOMLDecodeError): return None


TRIAL = Path("/var/lib/snitch-trial/deadline")  # root-owned, see /usr/local/sbin/snitch-trial


def set_default(mode, keep=False, trial="10m"):
    """deny is a trial: snitch-trial (root timer + boot check) goes back to allow unless --keep.
    On 2026-10-09 deny by default cut RDP and SSH: right after Little Snitch starts, its program
    rules don't apply yet, and a timer in memory died with the reboot that followed."""
    if mode == "deny" and keep:
        subprocess.run(["sudo", "rm", "-f", str(TRIAL)], check=True)
        return print("deny by default kept (trial ended)")
    if mode == "deny":
        timer = subprocess.run(["systemctl", "is-active", "-q", "snitch-trial.timer"])
        if timer.returncode != 0:
            sys.exit("snitch-trial.timer is not running: no deny without the automatic way back")
        baseline()
        deadline = int(time.time()) + secs(trial)
        subprocess.run(["sudo", "tee", str(TRIAL)], input=f"{deadline}\n", text=True, stdout=subprocess.DEVNULL, check=True)
    else:
        subprocess.run(["sudo", "rm", "-f", str(TRIAL)], check=True)
    text = (LS_OVERRIDE if LS_OVERRIDE.exists() else LS_CONF).read_text()
    text = re.sub(r"(?m)^deny_by_default\s*=.*$", f"deny_by_default = {str(mode == 'deny').lower()}", text)
    subprocess.run(["sudo", "tee", str(LS_OVERRIDE)], input=text, text=True, stdout=subprocess.DEVNULL, check=True)
    subprocess.run(["sudo", "systemctl", "restart", "littlesnitch"], check=True)
    print(f"Little Snitch: {mode} by default (override: {LS_OVERRIDE})")
    if mode == "deny":
        print(f"trial: back to allow at {datetime.fromtimestamp(deadline):%H:%M} and at the next boot;"
              " keep it with: snitch default deny --keep")
    subprocess.run(["pkill", "-RTMIN+14", "-x", "waybar"])


