# ---- rules (ordinary Little Snitch rules: listed, editable and deletable in the web UI) ------
def narrow(path):
    """Little Snitch expands wildcards in rule paths by walking the filesystem: a rule for "/**"
    hung its web server. Paths must be absolute, without "**", with no wildcard in the first two
    components (/usr/bin/python3.* and ~/.local/share/claude/versions/* are fine)."""
    if path is None: return None
    parts = path.split("/")
    if not path.startswith("/") or "**" in path or any(c in "".join(parts[:3]) for c in "*?["):
        raise ValueError(f"rule path too broad for Little Snitch: {path}")
    return path


def rule(action, primary=None, via=None, remote=None, port="Any", protocol=31, direction=1, until=None, note=""):
    primary, via, now = narrow(primary), narrow(via), int(time.time())
    return {"id": 0, "primaryExecutable": primary, "viaExecutable": via, "remotePattern": remote or {"type": "any"},
            "port": port, "protocol": protocol, "direction": direction, "priority": 1, "action": action,
            "isDisabled": False, "lifetime": {"Until": now + until} if until else "Forever",
            "creationDate": now, "modificationDate": now, "notes": note}


def rule_for(info, action, until=None):
    """A rule for one blocked connection as the daemon described it (setInspector)."""
    name = info.get("remoteName") or {}
    if name.get("value"):
        remote = {"type": "domains" if name.get("type") == "domain" else "hosts", "value": name["value"]}
    else:
        remote = {"type": "ipAddresses", "value": info["ipAddress"]}
    note = f"snitch popup {datetime.now():%Y-%m-%d %H:%M}" + (f", for {until // 60} min" if until else "")
    return rule(action, info.get("primaryExecutable"), info.get("viaExecutable"), remote,
                direction=2 if info.get("isInbound") else 1, until=until, note=note)


async def daemon_rules(add=(), edit=()):
    """Add rules / replace existing ones (same id); returns (all rules before, rules added)."""
    async with websockets.connect(URL, origin=ORIGIN, max_size=None) as ws:
        await ws.send(json.dumps({"action": "setSection", "section": "rules"}))
        before, added, end = None, [], time.monotonic() + 4 + 0.2 * len(add)
        while time.monotonic() < end and (before is None or len(added) < len(add)):
            try: msgs = json.loads(await asyncio.wait_for(ws.recv(), 0.5))
            except TimeoutError: continue
            for m in msgs:
                if m.get("update") == "setRules" and before is None:
                    before = m["rules"]
                    for r in add: await ws.send(json.dumps({"action": "addRule", "rule": r}))
                    for r in edit: await ws.send(json.dumps({"action": "editRule", "rule": r}))
                elif m.get("update") == "updateRules":
                    added += m.get("rulesAdded", [])
        return before or [], added


