async def watch(conf):
    """Third hidden connection: only denied rows, fully expanded. A blocked connection that no
    rule covers (denied by default) gets a popup, one at a time."""
    prompt_on = set(filter(None, os.environ.get("SNITCH_PROMPT_ON", "").split(","))) or {"denyByDefault"}
    RUN.mkdir(parents=True, exist_ok=True)
    snooze = secs(conf.get("snooze", "10m"))
    queue, asked_at, blocked, seq, up = asyncio.Queue(), {}, [], 0, False

    def status():
        (RUN / "status.json").write_text(json.dumps({"ts": time.time(), "blocked_1h": len(blocked),
                                                     "queued": queue.qsize(), "down": not up}))
        subprocess.run(["pkill", "-RTMIN+14", "-x", "waybar"])

    async def heartbeat():  # the bar treats a status older than 2 min as "not running"
        while True:
            now = time.time()
            blocked[:] = [t for t in blocked if now - t < 3600]
            status()
            await asyncio.sleep(60)

    async def popups():
        nonlocal seq
        while True:
            info = await queue.get()
            seq += 1
            f = RUN / f"ask-{seq}.json"
            f.write_text(json.dumps(info))
            test = f"env SNITCH_ASK_KEY={os.environ['SNITCH_ASK_KEY']} " if os.environ.get("SNITCH_ASK_KEY") else ""  # tests
            launch = await asyncio.create_subprocess_exec(
                str(BIN / "hypr-launch"), f"{test}foot --app-id=snitch-alert -e {BIN / 'snitch'} ask {f}")
            await launch.wait()
            end = time.monotonic() + 600  # the popup is another process: it removes the file when done
            while f.exists() and time.monotonic() < end: await asyncio.sleep(0.3)  # noqa: ASYNC110
            f.unlink(missing_ok=True)
            status()

    rules = {}  # row id -> allowByDefault / denyByDefault / denyByRule ... (this connection's rows)

    async def consider(m):
        if not (m.get("remoteName") or {}).get("value") and not m.get("ipAddress"): return
        if rules.get(m["row"]) not in prompt_on: return
        key = (m.get("primaryExecutable"), m.get("viaExecutable"),
               (m.get("remoteName") or {}).get("value") or m.get("ipAddress"), m.get("isInbound"))
        if time.time() - asked_at.get(key, 0) < snooze: return
        asked_at[key] = time.time()
        await queue.put({k: m.get(k) for k in ("primaryExecutable", "viaExecutable", "remoteName",
                                               "ipAddress", "isInbound", "protocol", "port")})

    _tasks = [asyncio.create_task(popups()), asyncio.create_task(heartbeat())]  # keep references
    while True:
        try:
            async with websockets.connect(URL, origin=ORIGIN, max_size=None) as ws:
                tree, info, asked, up = Tree(), {}, set(), True
                rules.clear()
                await ws.send(json.dumps({"action": "setConnectionsFilters", "filters": {
                    "direction": 3, "action": "deny", "localnet": None, "localhost": False, "visiblePeriodLimit": 3600}}))
                status()

                async for raw in ws:
                    for m in json.loads(raw):
                        u = m.get("update")
                        if tree.apply(m) and u == "insertConnectionRows":
                            await expand_to_hosts(ws, m["rows"], asked)
                        elif u == "updateRuleButtons":
                            rules.update({r["rowId"]: r["rule"] for r in m["rows"]})
                        elif u == "setInspector" and m.get("row") in tree.rows:
                            info[m["row"]] = m
                            await consider(m)
                        elif u == "trafficEvents":
                            for e in m.get("data", []):
                                rid = e.get("rowId")
                                if e.get("type") != "blocked" or rid not in tree.rows: continue
                                now = time.time()
                                blocked[:] = [t for t in blocked if now - t < 3600] + [now]
                                if rules.get(rid) not in prompt_on: continue
                                if rid in info: await consider(info[rid])
                                else: await ws.send(json.dumps({"action": "selectRow", "id": rid}))
                        if u == "trafficEvents": status()

        except (OSError, websockets.WebSocketException):
            up = False
            status()
            await asyncio.sleep(3)


def ask(path, conf):
    """The popup: o allow, x block, O / X the same for `temporary`, esc ask later."""
    f, temp = Path(path), conf.get("temporary", "15m")
    try:
        info = json.loads(f.read_text())
    except OSError:
        return
    name = info.get("remoteName") or {}
    remote = name.get("value") or info.get("ipAddress") or "?"
    prog, start = info.get("viaExecutable") or info.get("primaryExecutable") or "?", info.get("primaryExecutable")
    G, R, D, B, N = "\033[32m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"
    print(f"\033]2;snitch alert\007\n {R}{B}BLOCKED{N} {'inbound' if info.get('isInbound') else 'outbound'}"
          f" connection{D}  denied by default  {datetime.now():%H:%M:%S}{N}\n")
    print(f"   program  {B}{Path(prog).name}{N}  {D}{prog}{N}")
    if info.get("viaExecutable") and start: print(f"   for      {Path(start).name}  {D}{start}{N}")
    print(f"   {'from' if info.get('isInbound') else 'to  '}     {B}{remote}{N}  {D}{name.get('type') or 'ip'}"
          f"{'  port ' + str(info['port']) if info.get('port') else ''}{N}\n")
    print(f"   {G}o{N} allow   {R}x{N} block   {G}O{N} allow {temp}   {R}X{N} block {temp}   {D}esc later{N}")
    time.sleep(0.6)  # a popup that appears while typing must not take the next key
    fd = sys.stdin.fileno()
    termios.tcflush(fd, termios.TCIFLUSH)
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        key = os.environ.get("SNITCH_ASK_KEY") or os.read(fd, 1).decode(errors="ignore")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    choice = {"o": ("allow", None), "x": ("deny", None), "O": ("allow", secs(temp)), "X": ("deny", secs(temp))}.get(key)
    try:
        if choice:
            r = rule_for(info, *choice)
            added = asyncio.run(daemon_rules([r]))[1]
            what = ("ALLOWED   " if choice[0] == "allow" else "BLOCKED   ") + (f"for {temp} " if choice[1] else "")
            line = f"{datetime.now():%Y-%m-%d %H:%M:%S}  {what}{Path(prog).name} > {remote} (popup)"
            LOG.parent.mkdir(parents=True, exist_ok=True)
            with LOG.open("a") as log: log.write(line + "\n")
            print(f"\n   {G if added else R}{'rule stored: ' + what.strip() if added else 'the daemon did not store the rule'}{N}")
            time.sleep(0.6 if added else 4)
    finally:
        f.unlink(missing_ok=True)


def waybar_status():
    mode = deny_by_default()
    try: st = json.loads((RUN / "status.json").read_text())
    except (OSError, ValueError): st = {}
    alive = st and time.time() - st.get("ts", 0) < 120 and not st.get("down")
    icon = "\U000F0498" if mode else "\U000F0499"  # shield (deny by default) / shield outline (allow)
    cls = "down" if mode is None or not alive else ("deny" if mode else "allow")
    tip = [f"Little Snitch: {'deny' if mode else 'allow'} by default" if mode is not None else "Little Snitch: config unreadable",
           f"blocked in the last hour: {st.get('blocked_1h', 0)}" if alive else "alerts: snitch-watch not running",
           "click: connections / right-click: egress graph", "snitch default deny|allow switches the mode"]
    print(json.dumps({"text": icon + (f" {st['blocked_1h']}" if alive and st.get("blocked_1h") else ""), "class": cls,
                      "tooltip": "\n".join(tip)}))


def main():
    conf = tomllib.loads(CONF.read_text()) if CONF.exists() else {}
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", default="overview",
                    choices=["overview", "egress", "watch", "ask", "status", "default", "baseline"])
    ap.add_argument("arg", nargs="?", help="ask: the alert file; default: deny or allow")
    ap.add_argument("--since", default=conf.get("since", "1h"), help="time window, e.g. 15m 30m 1h 24h 7d")
    ap.add_argument("--dev", action="store_true", help="baseline: also the dev tools' allow rules")
    ap.add_argument("--keep", action="store_true", help="default deny: end the trial, keep deny by default")
    a = ap.parse_args()
    if a.cmd == "watch": return asyncio.run(watch(conf))
    if a.cmd == "ask": return ask(a.arg, conf)
    if a.cmd == "status": return waybar_status()
    if a.cmd == "baseline": return baseline(dev=a.dev)
    if a.cmd == "default":
        if a.arg not in ("deny", "allow"): ap.error("snitch default deny|allow")
        return set_default(a.arg, keep=a.keep, trial=conf.get("trial", "10m"))
    periods = conf.get("periods", ["15m", "30m", "1h", "24h", "7d"])
    if a.since not in periods: periods = sorted([*periods, a.since], key=secs)
    app = Snitch(periods, a.since, conf.get("protect", ["hypr-rdp", "sshd", "littlesnitch"]), conf.get("resort", [10, 20]))
    app.start_egress = a.cmd == "egress"
    app.run()


if __name__ == "__main__":
    main()
