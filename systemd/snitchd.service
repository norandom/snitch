# snitchd: egress control in the kernel, always on, always starting in monitor mode. The unit
# never passes -mode: the daemon reads the trial and kept-enforce files under /var/lib/snitch
# (fail-safe 5: deny only as a timed trial with a boot revert). snitchd-trial-boot.service
# runs first at boot and ends an open trial, so a reboot never comes back enforcing; it is
# enabled next to this unit, never pulled in by Wants= (a Wants= would start the oneshot on
# every restart of the daemon and end a live trial). While the daemon is down the kernel
# program fails open (no heartbeat), and the kill switch map survives restarts. Not installed
# or enabled by this repo: the VM repo's pyinfra flow deploys it.
[Unit]
Description=snitch: egress control in the kernel (monitor unless a trial or kept enforce says otherwise)
After=snitchd-trial-boot.service

[Service]
ExecStart=/usr/local/sbin/snitchd -rules /etc/snitch/rules.toml
Restart=on-failure
RestartSec=2
# SIGTERM (the default KillSignal) makes the daemon detach its hooks and exit.
TimeoutStopSec=10
# The trial and kept-enforce files (0700: the daemon leaves an existing directory's mode alone).
StateDirectory=snitch
StateDirectoryMode=0700
# The status file for `snitchd status` and the API socket: 0755 so every local user reaches the
# socket (0666, the daemon sets it); the status file itself is 0600, the daemon's own.
RuntimeDirectory=snitch
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
